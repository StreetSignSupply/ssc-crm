rules_version = '2';
// Street Sign Supply CRM — who may read and change the database.
// Only people on the team list can open anything. Their record in /access (one per sign-in email and per sign-in id,
// kept in step with the team list by the owner's CRM) gives their level: owner, office, sales or shop.
// Background jobs use the project's service account, which these rules don't apply to.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function emailKey() { return request.auth.token.email != null && request.auth.token.email_verified == true
                                  ? request.auth.token.email.lower() : "-"; }
    function byId() { return exists(/databases/$(db)/documents/access/$(request.auth.uid)); }
    function byEmail() { return exists(/databases/$(db)/documents/access/$(emailKey())); }
    function member() { return signedIn() && (byId() || byEmail()); }
    function role() { return byId() ? get(/databases/$(db)/documents/access/$(request.auth.uid)).data.role
                                     : get(/databases/$(db)/documents/access/$(emailKey())).data.role; }
    function acc() { return byId() ? get(/databases/$(db)/documents/access/$(request.auth.uid)).data
                                   : get(/databases/$(db)/documents/access/$(emailKey())).data; }
    // the team record this sign-in belongs to, and its own @streetsignsupply.com address (kept on the access record)
    function myTeamId() { return acc().get("teamId", "-"); }
    function myMail() { return acc().get("mail", ""); }
    function isOwner() { return member() && role() == "owner"; }
    function isOffice() { return member() && role() in ["owner", "office"]; }
    function isShop() { return member() && role() == "shop"; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // the team member this record is: their sign-in email or one of their sign-in ids
    function isSelf(d) { return (d.get("email", "") is string && d.get("email", "").lower() == emailKey())
                             || d.get("claudeId", "") == request.auth.uid
                             || (d.get("claudeIds", []) is list && request.auth.uid in d.get("claudeIds", [])); }

    // a person may record their own sign-in id on their record, and nobody else's
    function ownIdsOnly() {
      return (!changed().hasAny(["claudeId"]) || request.resource.data.claudeId == request.auth.uid)
          && (!changed().hasAny(["claudeIds"])
              || (request.resource.data.claudeIds is list
                  && request.resource.data.claudeIds.toSet().difference(resource.data.get("claudeIds", []).toSet()).hasOnly([request.auth.uid])
                  && request.resource.data.claudeIds.toSet().hasAll(resource.data.get("claudeIds", []).toSet())));
    }
    // the access list itself: only owners change it
    match /access/{key} {
      allow read: if member();
      allow write: if isOwner();
    }
    // the team list: owners add and remove people and set levels; everyone else can only update their own record,
    // and never its level
    match /team/{id} {
      allow read: if member();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (member() && isSelf(resource.data) && !changed().hasAny(["access", "companyDash", "email", "role"])
                                     && ownIdsOnly());
    }
    // settings: owners and office; keys and tokens live in settings/secrets, which only they can read;
    // the record of what's been sent to the sheet is kept up by every copy of the CRM; the lock switch is the owner's
    match /settings/{id} {
      allow read: if (id == "secrets" || id == "qbinv") ? isOffice() : member();
      // the sign-picture library: anyone but the shop can set a picture (only the byCode list changes)
      allow write: if id == "syncsent" ? member() : (id == "signlib" ? (member() && !isShop() && (resource == null || changed().hasOnly(["byCode"]))) : (id == "dbLock" ? isOwner()
                    : isOffice() && !(id != "secrets" && request.resource.data.get("shopToken", "") != "")));
    }
    // change history is add-only: every entry already there stays exactly as it was, new ones go on the end.
    // Once a record's list reaches 400 the oldest drop off, but the newest 300 must all still be there.
    function oldE() { return resource.data.get("entries", []); }
    function newE() { return request.resource.data.get("entries", []); }
    function sameRec() { return request.resource.data.get("recType", "") == resource.data.get("recType", "")
                             && request.resource.data.get("recId", "") == resource.data.get("recId", ""); }
    function appended() { return newE().size() >= oldE().size() && (oldE().size() == 0 || newE()[0:oldE().size()] == oldE()); }
    function trimmed() { return oldE().size() >= 380 && newE().size() <= 400
                             && newE().hasAll(oldE()[oldE().size() - 300:oldE().size()]); }
    match /history/{id} {
      allow read, create: if member();
      allow update: if member() && sameRec() && (appended() || trimmed());
      allow delete: if isOwner();
    }
    // quotes and projects: the shop doesn't change prices, billing or the stage
    match /projects/{id} {
      allow read, create: if member();
      allow update: if member() && !(isShop() && changed().hasAny(["orderLines", "value", "amountAuto", "billStatus", "billDate", "paidDate", "invNum", "invTax", "depositAmt", "quote", "price"]));
      allow delete: if isOffice();
    }
    // inventory: sales and shop count and move stock; only owners and office change what things cost
    match /items/{id} {
      allow read, create: if member();
      allow update: if member() && (isOffice() || !changed().hasAny(["cost", "vendorPrice", "vendorFreight", "vendors", "vendorId", "sell"]));
      allow delete: if isOffice();
    }
    match /vendors/{id} {
      allow read: if member();
      allow create, update: if isOffice() || (member() && !isShop());
      allow delete: if isOffice();
    }
    // accounts and contacts: owners, office and sales; the shop reads them
    match /accounts/{id} {
      allow read: if member();
      allow create, update: if member() && !isShop();
      allow delete: if isOffice();
    }
    match /contacts/{id} {
      allow read: if member();
      allow create, update: if member() && !isShop();
      allow delete: if isOffice();
    }
    // work orders: the shop moves them along (status, steps, QC, notes) but doesn't create them or change what's ordered or its price
    match /jobs/{id} {
      allow read: if member();
      allow create: if member() && !isShop();
      allow update: if member() && !(isShop() && changed().hasAny(["lines", "orderLines", "value", "price", "projectId", "accountId", "num", "deleted"]));
      allow delete: if isOffice();
    }
    // stock moves are add-only; undoing a move only flips its undo fields; anything else is owners and office
    match /invtx/{id} {
      allow read, create: if member();
      // anyone may undo a move (its qty goes to 0 and the old qty is kept) or redo it (the kept qty comes back) — never set a new qty
      allow update: if isOffice() || (member() && changed().hasOnly(["undone", "undoneAt", "undoneBy", "undoneWhy", "qty", "qtyWas", "redoneAt", "redoneBy"])
                       && ((request.resource.data.get("undone", false) == true && request.resource.data.qty == 0
                            && request.resource.data.get("qtyWas", null) == resource.data.qty && resource.data.get("undone", false) != true)
                        || (request.resource.data.get("undone", true) == false && resource.data.get("undone", false) == true
                            && request.resource.data.qty == resource.data.get("qtyWas", null))));
      allow delete: if isOffice();
    }
    // email the CRM sends: a task notice to one person on the team, or a customer email the team wrote. A customer email
    // always goes from the writer's own @streetsignsupply.com address (never anyone else's), to at most 10 people, and
    // waits for the owner's OK ("approval") unless an owner wrote it. Only the owner approves or turns one down;
    // the mail worker checks the approval again before it sends, and only it marks one sent.
    function custMail() { return request.resource.data.get("kind", "") == "customer"; }
    match /mail/{id} {
      allow read: if isOffice();
      allow create: if member() && request.resource.data.to is list && (
                      (!custMail() && request.resource.data.to.size() == 1 && request.resource.data.to[0] is string
                       && exists(/databases/$(db)/documents/access/$(request.resource.data.to[0].lower())))
                   || (custMail() && request.resource.data.to.size() >= 1 && request.resource.data.to.size() <= 10
                       && request.resource.data.get("cc", []) is list && request.resource.data.get("cc", []).size() <= 10
                       && request.resource.data.get("from", "") is string && myMail() != ""
                       && request.resource.data.get("from", "").lower() == myMail()
                       && request.resource.data.get("byId", "") == myTeamId()
                       && !request.resource.data.keys().hasAny(["approvedUid", "approvedAt", "approvedBy"])
                       && (request.resource.data.get("status", "") == "approval"
                           || (request.resource.data.get("status", "") == "queued" && isOwner()))));
      allow update: if isOwner() && resource.data.get("status", "") == "approval"
                    && changed().hasOnly(["status", "approvedUid", "approvedAt", "approvedBy", "rejectedAt", "rejectedBy"])
                    && ((request.resource.data.status == "queued" && request.resource.data.get("approvedUid", "") is string && request.resource.data.get("approvedUid", "") != "")
                        || request.resource.data.status == "rejected");
      allow delete: if false;
    }
    // signature requests: the link's long random code is the key. Anyone with the link can read that one request (never
    // list them), and the customer can change it once — from "sent" to signed or "changes asked for", before it expires —
    // touching only the signature fields; opening it can stamp viewedAt once. The team makes, cancels and files them.
    function signFields() { return ["status", "signedName", "signedTitle", "signedAt", "sigImg", "ua", "note", "po", "pieces"]; }
    function publicSign() {
      return resource.data.status == "sent" && request.time.toMillis() < resource.data.get("expiresAt", 0)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(signFields())
        && request.resource.data.status in ["signed", "declined"]
        && request.resource.data.signedName is string && request.resource.data.signedName.size() >= 2 && request.resource.data.signedName.size() <= 120
        && request.resource.data.signedAt is int
        && request.resource.data.get("note", "") is string && request.resource.data.get("note", "").size() <= 1000
        && request.resource.data.get("po", "") is string && request.resource.data.get("po", "").size() <= 80
        && request.resource.data.get("pieces", []) is list && request.resource.data.get("pieces", []).size() <= 40
        && (request.resource.data.status == "declined"
            || (request.resource.data.get("sigImg", "") is string && request.resource.data.get("sigImg", "").size() <= 200000
                && request.resource.data.get("sigImg", "").matches("^data:image/png;base64,[A-Za-z0-9+/=]+$")));
    }
    function publicView() {
      return resource.data.status == "sent" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewedAt"])
        && resource.data.get("viewedAt", 0) == 0 && request.resource.data.viewedAt is int;
    }
    // AI email drafts: a team member asks, the mail worker writes the answer back; only they (and the owner) read it.
    // The writing rules live in the worker, not in the request.
    match /aidraft/{id} {
      allow read: if member() && (resource.data.get("byId", "") == myTeamId() || isOwner());
      allow create: if member() && request.resource.data.status == "queued" && request.resource.data.get("byId", "") == myTeamId()
                    && !request.resource.data.keys().hasAny(["rules"]);
      allow update, delete: if false;
    }
    match /signreq/{t} {
      allow get: if t.size() >= 32;
      allow list: if member();
      allow create: if member() && t.size() >= 32 && request.resource.data.status == "sent";
      allow update: if member() || publicSign() || publicView();
      allow delete: if isOffice();
    }
    // number counters only go up; the fix-run record is for background jobs only
    match /meta/{id} {
      allow read: if member();
      allow create, update: if member() && id != "fixruns" && (id != "counter" || (
          request.resource.data.get("nextJob", 0) >= (resource == null ? 0 : resource.data.get("nextJob", 0))
          && request.resource.data.get("nextProject", 0) >= (resource == null ? 0 : resource.data.get("nextProject", 0))
          && request.resource.data.get("nextQuote", 0) >= (resource == null ? 0 : resource.data.get("nextQuote", 0))));
      allow delete: if false;
    }
    // files: anyone on the team adds them; moving one to the bin is office, or the person who uploaded it —
    // and signed quotes, signed proofs, signed work orders, purchase orders and invoices only the owner
    function lockedCat() { return resource.data.get("cat", "") in ["Signed quote", "Signed proof", "Signed work order", "Purchase order", "Invoice"]
                                  && resource.data.get("gen", "") == ""; }
    // a PDF the CRM made itself, replaced by a newer copy of the same quote or invoice
    function superseded() { return resource.data.get("gen", "") != "" && request.resource.data.get("supersededBy", "") != ""
                                   && changed().hasOnly(["deleted", "deletedAt", "deletedBy", "supersededBy", "updatedAt"]); }
    match /files/{id} {
      allow read, create: if member();
      allow update: if member() && (!changed().hasAny(["deleted", "cat", "projectId", "accountId"])
                       || isOwner() || superseded()
                       || (!lockedCat() && (isOffice() || resource.data.get("byId", "") == myTeamId())));
      allow delete: if isOwner();
    }
    // day-to-day records: activity, events, reminders, notifications
    match /{coll}/{id=**} {
      allow read, create, update: if member() && coll in ["activity", "events", "reminders", "notifications", "filedata"];
      allow delete: if isOffice() && coll in ["activity", "events", "reminders", "notifications", "filedata"];
    }
  }
}
