rules_version = '2';
// Street Sign Supply CRM — who may read and change the database.
// Only people on the team list can open anything. Their record in /access (one per sign-in email and per sign-in id,
// kept in step with the team list by the owner's CRM) says their level: owner, office, sales or shop.
// Background jobs use the project's service account, which these rules don't apply to.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function emailKey() { return request.auth.token.email != null && request.auth.token.email_verified == true
                                  ? request.auth.token.email.lower() : "-"; }
    function byId() { return exists(/databases/$(db)/documents/access/$(request.auth.uid)); }
    function byEmail() { return exists(/databases/$(db)/documents/access/$(emailKey())); }
    function member() { return signedIn() && (byId() || byEmail()); }
    function role() { return byId() ? get(/databases/$(db)/documents/access/$(request.auth.uid)).data.role
                                     : get(/databases/$(db)/documents/access/$(emailKey())).data.role; }
    function isOwner() { return member() && role() == "owner"; }
    function isOffice() { return member() && role() in ["owner", "office"]; }

    // the access list itself: only owners change it
    match /access/{key} {
      allow read: if member();
      allow write: if isOwner();
    }
    // the team list: owners add and remove people and set levels; anyone on it can update the rest of their record
    match /team/{id} {
      allow read: if member();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (member() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["access", "companyDash"]));
    }
    // settings: owners and office
    match /settings/{id} {
      allow read: if member();
      allow write: if isOffice();
    }
    // change history: anyone on the team adds to it; only owners remove it (purging deleted records)
    match /history/{id} {
      allow read, create, update: if member();
      allow delete: if isOwner();
    }
    // everything else: read and edit for the team; hard deletes for owners and office (everyday deletes are soft)
    // (the collections above have their own rules; a rule here would also match them, so they're left out)
    match /{coll}/{id=**} {
      allow read, create, update: if member() && !(coll in ["access", "team", "settings", "history"]);
      allow delete: if isOffice() && !(coll in ["access", "team", "settings", "history"]);
    }
  }
}
